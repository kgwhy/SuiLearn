# SuiLearn full-stack Docker Compose example.
# Copy to .env and fill the AI Provider values when you need AI features.

SUILEARN_WEB_PORT=5174
SUILEARN_API_PORT=8080
SUILEARN_POSTGRES_PORT=5432
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

SUILEARN_POSTGRES_DB=suilearn
SUILEARN_POSTGRES_USER=suilearn
SUILEARN_POSTGRES_PASSWORD=suilearn_dev_password

# Local-only RabbitMQ defaults. Override these with deployment-provided credentials outside local development.
SUILEARN_RABBITMQ_HOST=rabbitmq
SUILEARN_RABBITMQ_PORT=5672
SUILEARN_RABBITMQ_MANAGEMENT_PORT=15672
SUILEARN_RABBITMQ_USERNAME=suilearn
SUILEARN_RABBITMQ_PASSWORD=suilearn_rabbitmq_dev_password
SUILEARN_RABBITMQ_VHOST=suilearn

# Local-only MinIO defaults. The API uses the internal service endpoint; the host ports are for local tools.
SUILEARN_MINIO_ENDPOINT=http://minio:9000
SUILEARN_MINIO_PORT=9000
SUILEARN_MINIO_CONSOLE_PORT=9001
SUILEARN_MINIO_ACCESS_KEY=minioadmin
SUILEARN_MINIO_SECRET_KEY=suilearn_minio_dev_password
SUILEARN_MINIO_BUCKET=suilearn-assets

SUILEARN_ASYNC_PROCESSING_ENABLED=true
SUILEARN_OCR_ENABLED=true
SUILEARN_MAX_FILE_SIZE_MB=50
SUILEARN_PDF_MAX_PAGES=500
SUILEARN_PROCESSING_CONCURRENCY=2
SUILEARN_OCR_CONCURRENCY=1
SUILEARN_RETAIN_ORIGINAL=true
SUILEARN_KNOWLEDGE_POINT_AUTO_GENERATION_ENABLED=true

SUILEARN_PROCESSING_MAX_ATTEMPTS=3
SUILEARN_RABBITMQ_RETRY_SHORT_DELAY_MS=30000
SUILEARN_RABBITMQ_RETRY_LONG_DELAY_MS=300000
SUILEARN_PARSER_TIMEOUT_MS=120000
SUILEARN_OCR_TIMEOUT_MS=60000
SUILEARN_LIBREOFFICE_TIMEOUT_MS=120000
SUILEARN_ADAPTER_MAX_RETRIES=0
SUILEARN_CIRCUIT_BREAKER_FAILURE_RATE_PERCENT=50
SUILEARN_CIRCUIT_BREAKER_SLIDING_WINDOW_SIZE=10
SUILEARN_CIRCUIT_BREAKER_MINIMUM_CALLS=5
SUILEARN_CIRCUIT_BREAKER_OPEN_STATE_MS=60000
SUILEARN_CIRCUIT_BREAKER_HALF_OPEN_CALLS=2

# Docker API 默认经宿主机发布端口连接数据库；Docker PostgreSQL 和本地 PostgreSQL 都无需切换。
# 仅在数据库不使用默认宿主机端口时覆盖：
# SUILEARN_DB_URL=jdbc:postgresql://host.docker.internal:5432/suilearn

VITE_API_BASE_URL=/api/v2

# Docker Web 默认经宿主机发布端口连接后端；Docker API 和本地 Maven 后端都无需切换。
# 仅在后端不使用默认宿主机端口时覆盖：
# SUILEARN_API_UPSTREAM=http://host.docker.internal:8080

SUILEARN_AI_PROVIDER=openai-compatible
SUILEARN_AI_BASE_URL=https://api.deepseek.com/v1
SUILEARN_AI_API_KEY=""
SUILEARN_AI_CHAT_BASE_URL=https://api.deepseek.com/v1
SUILEARN_AI_CHAT_API_KEY=""
SUILEARN_AI_EMBEDDING_BASE_URL=
SUILEARN_AI_EMBEDDING_API_KEY=""
SUILEARN_AI_CHAT_MODEL=deepseek-v4-flash
SUILEARN_AI_EMBEDDING_MODEL=
SUILEARN_AI_TIMEOUT_MS=30000

# Study Agent is opt-in. Enabling it requires usable AI, Redis, and semantic-memory dependencies.
SUILEARN_AGENT_ENABLED=false
SUILEARN_AUTH_ENABLED=false
SUILEARN_AUTH_TOKENS=
SUILEARN_AGENT_WEBSOCKET_ENABLED=true
SUILEARN_AGENT_MAX_STEPS=4
SUILEARN_AGENT_SUBAGENT_MAX_STEPS=3
SUILEARN_AGENT_MAX_TOOL_CALLS=8
SUILEARN_AGENT_RUN_TIMEOUT=90s
SUILEARN_AGENT_CONTEXT_MAX_TOKENS=12000
SUILEARN_AGENT_PRACTICE_DEFAULT_COUNT=3
SUILEARN_AGENT_SESSION_TTL=24h
SUILEARN_AGENT_SESSION_MAX_TURNS=20
SUILEARN_AGENT_MEMORY_TOP_K=5
SUILEARN_AGENT_MEMORY_MIN_CONFIDENCE=0.80
