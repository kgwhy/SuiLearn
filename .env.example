# SuiLearn full-stack Docker Compose example.
# Copy to .env and fill the AI Provider values when you need AI features.

SUILEARN_WEB_PORT=5173
SUILEARN_API_PORT=8080
SUILEARN_POSTGRES_PORT=5432

SUILEARN_POSTGRES_DB=suilearn
SUILEARN_POSTGRES_USER=suilearn
SUILEARN_POSTGRES_PASSWORD=suilearn_dev_password

VITE_API_BASE_URL=/api/v2

SUILEARN_AI_PROVIDER=openai-compatible
SUILEARN_AI_BASE_URL=
SUILEARN_AI_API_KEY=
SUILEARN_AI_CHAT_BASE_URL=
SUILEARN_AI_CHAT_API_KEY=
SUILEARN_AI_EMBEDDING_BASE_URL=
SUILEARN_AI_EMBEDDING_API_KEY=
SUILEARN_AI_CHAT_MODEL=
SUILEARN_AI_EMBEDDING_MODEL=
SUILEARN_AI_TIMEOUT_MS=30000
SUILEARN_AI_MAX_RETRIES=2
