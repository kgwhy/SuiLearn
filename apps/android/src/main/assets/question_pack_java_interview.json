  "questions": [
    {
      "questionId": "jvm_memory_area_001",
      "categoryId": "jvm",
      "type": "SINGLE_CHOICE",
      "stem": "JVM 运行时数据区中，线程私有的是哪一组？",
      "options": [
        {
          "key": "A",
          "content": "堆和方法区"
        },
        {
          "key": "B",
          "content": "虚拟机栈、本地方法栈和程序计数器"
        },
        {
          "key": "C",
          "content": "堆和虚拟机栈"
        },
        {
          "key": "D",
          "content": "方法区和程序计数器"
        }
      ],
      "answer": [
        "B"
      ],
      "explanation": "虚拟机栈、本地方法栈和程序计数器随线程创建和销毁，属于线程私有；堆和方法区主要被线程共享。",
      "difficulty": 2,
      "knowledgePointIds": [
        "jvm_memory_model"
      ],
      "sortOrder": 1,
      "deprecated": false
    },
    {
      "questionId": "jvm_gc_roots_001",
      "categoryId": "jvm",
      "type": "MULTIPLE_CHOICE",
      "stem": "下列哪些对象通常可以作为 GC Roots？",
      "options": [
        {
          "key": "A",
          "content": "虚拟机栈中引用的对象"
        },
        {
          "key": "B",
          "content": "方法区中类静态属性引用的对象"
        },
        {
          "key": "C",
          "content": "本地方法栈 JNI 引用的对象"
        },
        {
          "key": "D",
          "content": "只存在于不可达环中的对象"
        }
      ],
      "answer": [
        "A",
        "B",
        "C"
      ],
      "explanation": "可达性分析从 GC Roots 出发，栈帧引用、静态属性引用、常量引用、JNI 引用等都可能是根；不可达环本身不能成为根。",
      "difficulty": 3,
      "knowledgePointIds": [
        "garbage_collection"
      ],
      "sortOrder": 2,
      "deprecated": false
    },
    {
      "questionId": "jvm_parent_delegation_001",
      "categoryId": "jvm",
      "type": "TRUE_FALSE",
      "stem": "双亲委派模型可以避免核心 Java 类被应用自定义类加载器随意替换。",
      "options": [
        {
          "key": "A",
          "content": "对"
        },
        {
          "key": "B",
          "content": "错"
        }
      ],
      "answer": [
        "A"
      ],
      "explanation": "双亲委派会先让父加载器尝试加载类，核心类通常由启动类加载器加载，有助于保证基础类库类型安全。",
      "difficulty": 2,
      "knowledgePointIds": [
        "class_loading"
      ],
      "sortOrder": 3,
      "deprecated": false
    },
    {
      "questionId": "jvm_oom_short_001",
      "categoryId": "jvm",
      "type": "SHORT_ANSWER",
      "stem": "排查 Java 线上 OOM 时，你会优先收集哪些信息？",
      "options": [],
      "answer": [
        "优先保留错误日志、JVM 参数、GC 日志、堆转储 dump、进程内存和最近发布变更，再用 MAT、jmap、jcmd 等工具分析大对象、泄漏链路和内存增长趋势。"
      ],
      "explanation": "OOM 排查不能只看异常名，要先保留现场，再区分堆溢出、元空间溢出、直接内存或线程过多等原因，结合 GC 日志和 dump 才能定位根因。",
      "difficulty": 4,
      "knowledgePointIds": [
        "jvm_memory_model",
        "garbage_collection"
      ],
      "sortOrder": 4,
      "deprecated": false
    },
    {
      "questionId": "jvm_class_init_001",
      "categoryId": "jvm",
      "type": "SINGLE_CHOICE",
      "stem": "类加载过程里，执行静态变量赋值和静态代码块的是哪个阶段？",
      "options": [
        {
          "key": "A",
          "content": "加载"
        },
        {
          "key": "B",
          "content": "验证"
        },
        {
          "key": "C",
          "content": "准备"
        },
        {
          "key": "D",
          "content": "初始化"
        }
      ],
      "answer": [
        "D"
      ],
      "explanation": "准备阶段会为类变量分配内存并设置零值，初始化阶段才执行类构造器 <clinit>，包括静态变量显式赋值和静态代码块。",
      "difficulty": 3,
      "knowledgePointIds": [
        "class_loading"
      ],
      "sortOrder": 5,
      "deprecated": false
    },
    {
      "questionId": "java_oop_001",
      "categoryId": "java_basics",
      "type": "SINGLE_CHOICE",
      "stem": "面向对象三大特性通常指什么？",
      "options": [
        {
          "key": "A",
          "content": "封装、继承、多态"
        },
        {
          "key": "B",
          "content": "编译、链接、运行"
        },
        {
          "key": "C",
          "content": "同步、异步、阻塞"
        },
        {
          "key": "D",
          "content": "索引、事务、锁"
        }
      ],
      "answer": [
        "A"
      ],
      "explanation": "封装隐藏对象内部实现，继承复用和扩展父类能力，多态让同一接口在不同实现下表现出不同行为。",
      "difficulty": 1,
      "knowledgePointIds": [
        "oop_principles"
      ],
      "sortOrder": 6,
      "deprecated": false
    },
    {
      "questionId": "java_string_001",
      "categoryId": "java_basics",
      "type": "MULTIPLE_CHOICE",
      "stem": "关于 Java String，下列说法正确的是哪些？",
      "options": [
        {
          "key": "A",
          "content": "String 对象不可变"
        },
        {
          "key": "B",
          "content": "字符串字面量通常会进入字符串常量池"
        },
        {
          "key": "C",
          "content": "== 总是比较两个字符串的内容"
        },
        {
          "key": "D",
          "content": "equals 通常用于比较字符串内容"
        }
      ],
      "answer": [
        "A",
        "B",
        "D"
      ],
      "explanation": "String 不可变，字面量会复用常量池对象；== 比较引用是否相同，内容比较应使用 equals。",
      "difficulty": 2,
      "knowledgePointIds": [
        "string_and_equals"
      ],
      "sortOrder": 7,
      "deprecated": false
    },
    {
      "questionId": "java_checked_exception_001",
      "categoryId": "java_basics",
      "type": "TRUE_FALSE",
      "stem": "受检异常必须在编译期被捕获或声明抛出。",
      "options": [
        {
          "key": "A",
          "content": "对"
        },
        {
          "key": "B",
          "content": "错"
        }
      ],
      "answer": [
        "A"
      ],
      "explanation": "除 RuntimeException 及其子类外，Exception 下的受检异常需要 catch 或 throws，否则无法通过编译。",
      "difficulty": 2,
      "knowledgePointIds": [
        "exceptions"
      ],
      "sortOrder": 8,
      "deprecated": false
    },
    {
      "questionId": "java_hashcode_short_001",
      "categoryId": "java_basics",
      "type": "SHORT_ANSWER",
      "stem": "为什么重写 equals 时通常也必须重写 hashCode？",
      "options": [],
      "answer": [
        "因为 HashMap、HashSet 等哈希集合先依赖 hashCode 定位桶，再用 equals 判断相等；两个 equals 相等的对象必须返回相同 hashCode，否则集合查找、去重可能出错。"
      ],
      "explanation": "equals 和 hashCode 有契约关系：相等对象必须有相同哈希值。只改 equals 会破坏哈希容器的定位逻辑，导致同一个逻辑对象被放入不同桶。",
      "difficulty": 3,
      "knowledgePointIds": [
        "string_and_equals"
      ],
      "sortOrder": 9,
      "deprecated": false
    },
    {
      "questionId": "java_interface_abstract_001",
      "categoryId": "java_basics",
      "type": "SINGLE_CHOICE",
      "stem": "关于接口和抽象类，下列说法最准确的是哪一项？",
      "options": [
        {
          "key": "A",
          "content": "接口只能被一个类实现"
        },
        {
          "key": "B",
          "content": "抽象类不能包含普通方法"
        },
        {
          "key": "C",
          "content": "接口偏向能力约定，抽象类可承载共性状态和模板逻辑"
        },
        {
          "key": "D",
          "content": "接口和抽象类没有任何区别"
        }
      ],
      "answer": [
        "C"
      ],
      "explanation": "Java 类只能单继承但可实现多个接口。接口更适合定义能力和契约，抽象类可以保存状态并复用部分实现。",
      "difficulty": 2,
      "knowledgePointIds": [
        "oop_principles"
      ],
      "sortOrder": 10,
      "deprecated": false
    },
